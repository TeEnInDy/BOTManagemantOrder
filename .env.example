# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=botdiscord

# --- Prisma ---
# รูปแบบ: mysql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=mysql://root:@127.0.0.1:3306/botdiscord

# --- Discord Bot ---
DISCORD_TOKEN=your-discord-bot-token
YOUR_DISCORD_CHANNEL_ID=your-channel-id

# --- Webhook Port (ต้องไม่ชนกับ Backend 4000) ---
PORT=4001
